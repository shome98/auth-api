# ═══════════════════════════════════════════════════════════
# 🔐 Personal Auth API — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ──── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──── Database (PostgreSQL) ─────────────────────────────────
# PostgreSQL credentials - DATABASE_URL is constructed from these
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=api-auth_db

# DATABASE_URL constructed from credentials above:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql://postgres:password@localhost:5432/api-auth_db

# Neon PostgreSQL (serverless) - uncomment if using Neon instead:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/auth_db?sslmode=require

# ──── Session ───────────────────────────────────────────────
SESSION_SECRET=replace-this-with-a-random-64-char-secret-key-here!!
SESSION_MAX_AGE_DAYS=7

# ──── Email Configuration ───────────────────────────────────
# In development, emails are sent via Mailtrap (if configured) or logged to console.
# For production, Resend is used (recommended) or fallback to SMTP.

# Resend (Production) - https://resend.com
# Set your Resend API key for production email delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailtrap (Development) - https://mailtrap.io
# Set these to test emails in development without sending real emails
MAILTRAP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILTRAP_INBOX_ID=1234567

# SMTP (Legacy fallback)
# Only used if Resend is not configured in production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Auth API <noreply@yourapp.com>"

# ──── Google OAuth ──────────────────────────────────────────
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ──── App URLs ──────────────────────────────────────────────
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
# Optional: allow multiple frontend origins for CORS.
# The first URL is used for OAuth/email redirects unless CLIENT_URL is set separately.
CLIENT_URLS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# ──── Guest Sessions ───────────────────────────────────────
GUEST_SESSION_MAX_AGE_DAYS=7
